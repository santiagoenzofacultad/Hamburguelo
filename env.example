# Copiá este archivo como ".env" para probar en tu compu con "netlify dev".
# En Netlify (online) estas variables se cargan en: Site configuration > Environment variables.
# NUNCA subas el archivo .env a GitHub ni lo compartas.

# Access Token de PRUEBA: Developer Dashboard > tu aplicación > Credenciales > pestaña Prueba
MP_ACCESS_TOKEN=APP_USR-...

# Opcional: dirección pública del sitio. Netlify ya define URL automáticamente.
APP_URL=
